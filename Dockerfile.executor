FROM gradle:8.7-jdk17

USER root
ENV ANDROID_HOME=/opt/android-sdk \
    ANDROID_SDK_ROOT=/opt/android-sdk \
    GRADLE_USER_HOME=/opt/gradle-cache
COPY requirements.executor.txt /tmp/requirements.executor.txt
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl unzip python3 python3-pip \
    && python3 -m pip install --no-cache-dir -r /tmp/requirements.executor.txt \
    && rm -rf /var/lib/apt/lists/*
RUN mkdir -p ${ANDROID_HOME}/cmdline-tools \
    && curl --fail --location --silent --show-error \
       --output /tmp/android-tools.zip \
       https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip \
    && unzip -q /tmp/android-tools.zip -d ${ANDROID_HOME}/cmdline-tools \
    && mv ${ANDROID_HOME}/cmdline-tools/cmdline-tools ${ANDROID_HOME}/cmdline-tools/latest \
    && rm /tmp/android-tools.zip
ENV PATH=${PATH}:${ANDROID_HOME}/cmdline-tools/latest/bin:${ANDROID_HOME}/platform-tools
WORKDIR /opt/kotlin-android-fixture
COPY tests/fixtures/kotlin-android/ ./
RUN chmod 0555 gradlew \
    && yes | sdkmanager --licenses \
    && sdkmanager "platform-tools" "platforms;android-35" "build-tools;35.0.0" \
    && ./gradlew --no-daemon test \
    && rm -rf build app/build
RUN chown -R 1000:1000 /opt/gradle-cache /opt/android-sdk /opt/kotlin-android-fixture
COPY executor-entrypoint.sh /usr/local/bin/executor-entrypoint
RUN chmod 0555 /usr/local/bin/executor-entrypoint
WORKDIR /workspace
USER gradle
ENTRYPOINT ["/usr/local/bin/executor-entrypoint"]
